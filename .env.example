# ---------------------------------------------------------------------------
# Database (required)
# ---------------------------------------------------------------------------
# Local development uses a throwaway Postgres container — see README.
# Production: a Neon or Supabase connection string.
DATABASE_URL="postgresql://metro:metro@localhost:55432/metro?schema=public"

# ---------------------------------------------------------------------------
# Email (optional)
# ---------------------------------------------------------------------------
# Without a key, transactional email is skipped and logged instead — orders and
# enquiries are still saved. Never let email failure break an order.
RESEND_API_KEY=""
# Must be a domain you have verified in Resend.
EMAIL_FROM="Metro Electric Co. <orders@metroelectricco.com.pk>"
# Where order + enquiry notifications land internally.
EMAIL_TO_INTERNAL="info@metroelectricco.com.pk"

# ---------------------------------------------------------------------------
# Site
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ---------------------------------------------------------------------------
# Payment gateway (Phase 2b — COD works without any of this)
# ---------------------------------------------------------------------------
# "cod" only, or "safepay" once the keys below are filled in.
PAYMENT_PROVIDER="cod"
# From Safepay dashboard > Developers > API Keys
SAFEPAY_CLIENT_KEY=""
SAFEPAY_SECRET_KEY=""
# From Safepay dashboard > Developers > Webhooks (a third, separate value)
SAFEPAY_WEBHOOK_SECRET=""
# sandbox | production
SAFEPAY_ENVIRONMENT="sandbox"

# ---------------------------------------------------------------------------
# Admin dashboard (required to sign in at /admin)
# ---------------------------------------------------------------------------
# Generate both with:  npm run admin:password -- "your-chosen-password"
ADMIN_PASSWORD_HASH=""
ADMIN_SESSION_SECRET=""
