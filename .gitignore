# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/.next-dev/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# runtime-uploaded product photos (admin uploads land directly in uploads/products/)…
/uploads/**
# …but the imported brand catalogue photos in uploads/products/<brand>/ are tracked,
# so a fresh clone or the server gets them with `git pull`.
!/uploads/products/
!/uploads/products/*/
!/uploads/products/*/**

# generated prisma client (recreated by postinstall)
/src/generated/

# nightly price-sync reports
/logs/
